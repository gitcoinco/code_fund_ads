<% content_for :breadcrumbs do %>
  <%= render "/@shared/breadcrumbs/dashboard" %>
  <%= render "/@shared/breadcrumbs/creatives" %>
  <%= render "/@shared/breadcrumbs/creative", creative: @creative, class: "active" %>
<% end %>

<% content_for :actions do %>
  <%= render "/@shared/actions/edit_creative", creative: @creative %>
<% end %>

<% content_for :page_heading do %>
  <%= page_heading "Viewing", "Creative",
    subtitle: @creative.name,
    icon: "fas fa-palette" %>
<% end %>

<main id="content" role="main" class="bg-light">
  <div class="container space-1">

    <div class="card-deck d-block d-lg-flex card-lg-gutters-3 mb-3">
      <%= render "/@shared/widgets/stat_card",
        label: "Impressions",
        value: "TBD",
        icon: "fas fa-eye",
        color: "btn-soft-info" %>
      <%= render "/@shared/widgets/stat_card",
        label: "Clicks",
        value: "TBD",
        icon: "fas fa-bullseye-pointer",
        color: "btn-soft-primary" %>
      <%= render "/@shared/widgets/stat_card",
        label: "CTR",
        value: "TBD",
        icon: "fas fa-percentage",
        color: "btn-soft-warning" %>
    </div>
    
    <div class="text-center mb-3 mt-5">
      <span class="u-divider u-divider--xs u-divider--text">Ad Previews</span>
    </div>

    <div class="row">
      <% ENUMS::AD_TEMPLATES.values.each do |template| %>
        <% ["light", "dark"].each do |theme| %>
          <div class="col-12">
            <div class="card mb-4">
              <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                  <h4 class="h6 mb-0"><%= template %> (<%= theme %>)</h4>
                  <div class="position-relative">
                    <%= link_to creative_previews_path(@creative, template: template, theme: theme), class: "btn btn-sm btn-icon btn-soft-secondary btn-bg-transparent", target: "_blank" do %>
                      <i class="fas fa-external-link btn-icon__inner"></i>
                    <% end %>
                  </div>
                </div>
              </div>
              <div class="card-body p-2">
                <iframe src="<%= creative_previews_path(@creative, template: template, theme: theme) %>"
                  height="270" style="height: 320px; width: 100%; border: 0; resize: horizontal;"
                  frameBorder="0" scrolling="no"></iframe>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</main>