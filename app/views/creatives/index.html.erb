<% content_for :breadcrumbs do %>
  <%= render "/@shared/breadcrumbs/dashboard" %>
  <%= render "/@shared/breadcrumbs/creatives", class: "active" %>
<% end %>

<% content_for :actions do %>
  <%= render "/@shared/actions/add_creative" %>
<% end %>

<% content_for :page_heading do %>
  <%= page_heading "Viewing", "Creatives",
    subtitle: "#{pluralize(@pagy.count, "record")} found",
    icon: "fas fa-palette" %>
<% end %>

<main id="content" role="main" class="bg-light">
  <div class="container space-1">
    <%#= render partial: "/creative_searchs/form",
              layout: "/@shared/collapsable_search_form",
              locals: { search: @creative_search } %>
    <div class="bg-white p-4">
      <%= render "/creatives/table", creatives: @creatives, pagy: @pagy %>
    </div>
  </div>
</main>