<%= render "/@shared/forms/error_messages", object: creative %>
<div data-controller="creative-form">
  <div class="row">
    <div class="col-md-6">
      <%= simple_form_for creative, html: { class: "js-validate" }, wrapper: :front_form do |f| %>
        <div class="row">
          <%= tag.div f.input(:name, required: true), class: "col-md-6 mb-3" %>
          <% if authorized_user.can_admin_system? %>
            <%= tag.div f.input(:user_id, label: "Advertiser", collection: User.advertiser.order(last_name: :asc).map { |u| [u.name, u.id] }, required: true,
              input_html: { class: "form-control", data: { controller: "select" }}), class: "col-md-6 mb-3" %>
          <% else %>
            <%= f.input :user_id, as: :hidden, input_html: { value: current_user.id } %>
            <div class="col-md-6 mb-3">
              <div class="js-form-message js-focus-state string required property_name">
                <label class="form-label string required" for="property_name">Advertiser <abbr title="required">*</abbr></label>
                <input type="text" class="form-control" placeholder="<%= current_user.name %>" aria-label="<%= current_user.name %>" readonly>
              </div>
            </div>
          <% end %>



          <div class="copy-wrapper col-12 p-0 py-2 mb-2" data-target="creative-form.copyWrapper">
            <div class="text-center text-secondary pb-2" data-target="creative-form.copyWarningWrapper">
              Your ad copy is <span class="actual-length text-dark" data-target="creative-form.adLength">0</span> of <strong class="text-dark">85</strong> characters
            </div>
            <%= tag.div f.input(:headline, required: true, input_html: { data: { target: "creative-form.inputHeadline", action: "change->creative-form#setHeadline keyup->creative-form#setHeadline" }}), class: "col-12 mb-3" %>
            <%= tag.div f.input(:body, required: true, input_html: { rows: 2, data: { target: "creative-form.inputBody", action: "change->creative-form#setBody keyup->creative-form#setBody" }}), class: "col-12 mb-3" %>
          </div>
          
          <%= tag.div f.input(:small_image, label: "Small Image",
                input_html: {
                  data: {
                    target: "creative-form.inputSmallImageId",
                    action: "change->creative-form#setSmallImage"
                  }
                },
                hint: "200x200",
                required: true,
                collection: small_images_for_select(current_user)
              ),
              class: "col-12 mb-3" %>

          <%= tag.div f.input(:large_image, label: "Large Image",
                input_html: {
                  data: {
                    target: "creative-form.inputLargeImageId",
                    action: "change->creative-form#setLargeImage"
                  }
                },
                hint: "260x200",
                required: true,
                collection: large_images_for_select(current_user)
              ),
              class: "col-12 mb-3" %>
          <%= tag.div f.input(:wide_image, label: "Wide Image",
                input_html: {
                  data: {
                    target: "creative-form.inputWideImageId",
                    action: "change->creative-form#setWideImage"
                  }
                },
                hint: "512x320",
                required: true,
                collection: wide_images_for_select(current_user)
              ),
              class: "col-12 mb-3" %>

          <div class="col-12 mt-5 mb-2">
            <%= f.submit "Save Creative", class: "btn btn-sm btn-primary transition-3d-hover mr-1" %>  
            <%= link_to "Cancel", campaigns_path, class: "btn btn-sm btn-soft-secondary transition-3d-hover" %>
          </div>
        </div>
      <% end %>
    </div>
    <div class="col-md-6">
      <div class="p-4 mb-3 bg-white shadow-lg rounded">
        <%= image_tag "anatomy-of-an-ad@2x.png", class: "img-fluid" %>
      </div>

      <div class="row justify-content-between align-items-center mb-4">
        <!-- Title -->
        <div class="col-sm-4 col-md-6 mb-3 mb-sm-0">
          <h2 class="h6 mb-0">Preview</h2>
        </div>
        <!-- End Title -->

        <!-- Filter -->
        <div class="col-sm-8 col-md-6 text-sm-right">
          <ul class="list-inline mb-0">
            <li class="list-inline-item">
              <!-- Select -->
              <select class="js-select selectpicker dropdown-select"
                      data-style="btn-sm btn-soft-primary"
                      data-target="creative-form.inputTemplateTheme"
                      data-action="change->creative-form#setTemplateTheme">
                <option value="default|light">Default (light)</option>
                <option value="default|dark">Default (dark)</option>
                <option value="centered|light">Centered (light)</option>
                <option value="centered|dark">Centered (dark)</option>
                <option value="horizontal|light">Horizontal (light)</option>
                <option value="horizontal|dark">Horizontal (dark)</option>
                <option value="vertical|light">Vertical (light)</option>
                <option value="vertical|dark">Vertical (dark)</option>
                <option value="image-centered|light">Image Centered (light)</option>
                <option value="image-centered|dark">Image Centered (dark)</option>
                <option value="image-only|light">Image Only (light)</option>
                <option value="image-only|dark">Image Only (dark)</option>
                <option value="square|light">Square (light)</option>
                <option value="square|dark">Square (dark)</option>
              </select>
              <!-- End Select -->
            </li>
          </ul>
        </div>
        <!-- End Filter -->
      </div>

      <div class="p-4 bg-white">
        <div id="creative-preview" data-target="preview">
          <span class="cf-wrapper">
            <a href="javascript:;" class="cf-img-wrapper" rel="noopener">
              <img data-target="creative-form.previewImageUrl" src="https://cdn.codefund.io/1a6f8eb2-6703-4d5b-8211-47a7aad53f67_gitcoin-2-260x200.png" alt="" border="0" height="100" width="130" class="cf-img">
            </a>
            <a href="javascript:;" class="cf-text" rel="noopener">
              <strong data-target="creative-form.previewHeadline">Gitcoin</strong>
              <span data-target="creative-form.previewBody">💰 Use your Python skills to grow Open Source, while getting paid.</span>
            </a>
            <a href="javascript:;" class="cf-powered-by" rel="noopener">
              ads via codefund.io
            </a>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
