<div class="page-inner page-inner-fill bg-white">
  <div class="page-fixed">
    <div class="nav-scroller">
      <div class="page-fixed-header">
        <div class="nav nav-tabs">
          <a class="nav-link active show" data-toggle="tab" href="#tab1">All <span class="badge">(7)</span></a>
          <a class="nav-link" data-toggle="tab" href="#tab2">Unread</a>
          <a class="nav-link" data-toggle="tab" href="#tab2">Assigned to Me</a>
          <a class="nav-link" data-toggle="tab" href="#tab2">Shared with Me</a>
          <a class="nav-link" data-toggle="tab" href="#tab2">Discussions</a>
          <a class="nav-link" data-toggle="tab" href="#tab2">Sent</a>
          <a class="nav-link" data-toggle="tab" href="#tab3">Trash</a>
        </div>
      </div><!-- /.nav -->
    </div>
    <div class="page-fixed-body">
      <div class="card card-fluid">
        <div clas="card-body">
          <div class="list-group list-group-flush list-group-divider">
            <% @emails.each do |email| %>
              <%= link_to email, class: "list-group-item list-group-item-action #{'active' if email.inbound? && email.unread?(current_user)}" do %>
                <div class="list-group-item-figure">
                  <% if email.sending_user %>
                    <div class="user-avatar">
                      <%= image_tag email.sending_user.gravatar_url("identicon", "48") %>
                    </div>
                  <% end %>
                </div>
                <div class="list-group-item-body d-flex justify-content-between">
                  <div class="text-truncate flex-grow-1">
                    <h4 class="list-group-item-title"><%= email.subject %></h4>
                    <p class="list-group-item-text">
                      <span class="text-dark"><%= email.sender %></span> – <%= email.snippet %>
                    </p>
                  </div>
                  <div style="width: 100px; display: inline-block;" class="text-right">
                    <%= email.delivered_at.strftime("%b %d") %>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
