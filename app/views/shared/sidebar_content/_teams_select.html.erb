<li class="mb-3 mx-2">
  <%= form_tag nil,
        data: {
          controller: "current-organization",
          target: "current-organization.currentOrganizationForm"
        },
        method: :get do %>
      <%= select_tag "current-organization",
        options_from_collection_for_select(user_organizations_for_select, "id", "name", Current.organization&.id),
        class: "form-control custom-select",
        data: {
          controller: "select",
          target: "current-organization.currentOrganizationSelect",
          action: "change->current-organization#updateCurrentOrganization"
        } %>
  <% end %>
 </li>
