<%= simple_form_for email_template, html: { class: "js-validate", id: "email-template-form" }, wrapper: :front_form do |f| %>
  <%= render "/@shared/forms/error_messages", object: email_template %>
  <%= f.hidden_field :body, value: email_template.body %>

  <div class="row">
    <%= tag.div f.input(:title, as: :string, required: true, input_html: { class: "form-control" },
      data: { msg: "Please enter a valid title", error_class: "u-has-error", success_class: "u-has-success" }), class: "col-12 mb-3" %>

    <%= tag.div f.input(:subject, as: :string, required: true, input_html: { class: "form-control" },
      hint: "Use the liquid template to use variables. For example, you can add their first name by using {{first_name}}",
      data: { msg: "Please enter a valid subject", error_class: "u-has-error", success_class: "u-has-success" }), class: "col-12 mb-3" %>

    <div class="col-12 mb-3">
      <div class="js-form-message js-focus-state string required email_template_body u-has-success">
        <label class="form-label string required" for="email_template_body">Body <abbr title="required">*</abbr></label>
        <div id="scrolling-container">
          <div id="quill-container" data-controller="rich-text-editor" data-form-id="email-template-form">
            <%= @email_template.body.html_safe %>
          </div>
        </div>
      </div>
    </div>

    <%= render "@shared/forms/button_panel" do %>
      <%= f.submit "Save Email Template", class: "btn btn-sm btn-primary transition-3d-hover mr-1" %>
      <%= link_to "Cancel", email_templates_path, class: "btn btn-sm btn-soft-secondary transition-3d-hover" %>
    <% end %>
  </div>
<% end %>
