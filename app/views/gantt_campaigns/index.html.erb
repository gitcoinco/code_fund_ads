<div class="page-inner">
  <%= render "/shared/page_heading_with_subtitle",
    title: "Campaign Gantt Chart",
    datepicker: false %>

  <div class="board d-flex flex-column overflow-x-auto p-0">
    <div class="gantt-container flex-grow-1">
      <%= tag.svg "", id: "gantt",
        data: {
          controller: "gantt-chart",
          items: @items.to_json
        } %>
    </div>
  </div>
</div>
