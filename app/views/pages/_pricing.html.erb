<div class="space-top-3 pb-2 bg-light">
  <div class="container">
    <%= tag.div "Loading...", id: "chartdiv", style: "width: 100%; height: 550px;",
      data: {
        controller: "pricing-map",
        ecpm: Campaign.pricing(params[:ecpm]&.to_f || ENV["BASE_ECPM"]&.to_f || 4).map { |val| {
          id: val[:country_iso_code],
          value: val[:ecpm].to_f,
          price: val[:ecpm].format }}
      } %>
  </div>
</div>