<% content_for :breadcrumbs do %>
  <%= render "/@shared/breadcrumbs/dashboard" %>
  <%= render "/@shared/breadcrumbs/properties" %>
  <%= render "/@shared/breadcrumbs/property", class: "active" %>
<% end %>

<% content_for :page_heading do %>
  <%= page_heading "Editing", "Property",
    subtitle: "Fill out the form below",
    icon: "browser" %>
<% end %>

<% content_for :actions do %>
  <%= render "/@shared/actions/show_property", property: @property %>
<% end %>


<main id="content" role="main">
  <div class="u-bg-light-blue-50">
    <div class="container u-space-1">
      <p id="notice"><%= notice %></p>
      <%= render "/properties/form", property: @property %>
    </div>
  </div>
</main>