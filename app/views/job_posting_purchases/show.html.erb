<main id="content" role="main" class="bg-light">
  <div class="container space-top-3 space-bottom-2">
    <div class="w-lg-80 mx-lg-auto">
      <div class="card shadow-sm p-7 job-listing">
        <h2 class="h4 mt-3">Success</h2>
        <p>Your job listing will be hosted on CodeFund Jobs for 30 days and will be auto renewed on <%= Date.current.advance(days: 30).to_s("abdy") %>.<p>
        <p><%= link_to "View your listing", job_posting_path(@job_posting) %></p>
      </div>
    </div>
  </div>
</main>
