<div class="input-group" data-controller="campaign-reports-email-form">
  <input type="email" placeholder="Enter an email address..." value="<%= email %>" class="form-control" style="min-width:300px;" data-target="campaign-reports-email-form.input" data-action="focus->campaign-reports-email-form#select">
  <div class="input-group-append">
    <button type="button" class="btn btn-outline-secondary" data-target="campaign-reports-email-form.button" data-action="click->campaign-reports-email-form#submit">
      Email Reports
    </button>
  </div>
</div>
