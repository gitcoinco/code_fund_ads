<%= simple_form_for image, url: image_path(imageable.to_gid_param, image), html: { class: "js-validate" } do |f| %>
  <div class="row">
    <div class="col-md-6">
      <%= render "/@shared/forms/section_heading", title: "Image Settings", subtitle: "Fill out the form" %>
      
      <div class="row">
        <%= tag.div f.input(:name, label: "Name", required: true), class: "col-12" %>
        <%= tag.div f.input(:format, label: "Format", as: :select, collection: image_formats_for_select.map { |val| [val.capitalize, val] }, required: true), class: "col-12" %>
        <%= tag.div f.input(:image, label: "Image", as: :file, required: !@image.persisted?), class: "col-12" %>
        <div class="col-12 mt-2 mb-2">
          <%= f.submit "Save Image", class: "btn btn-sm btn-primary transition-3d-hover mr-1" %>  
          <%= link_to "Cancel", images_path, class: "btn btn-sm btn-soft-secondary transition-3d-hover" %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <%= image_tag image.variant(geometry: "400x400>"), class: "img-thumbnail img-fluid d-block mb-2" %>
      <ul class="list-unstyled my-3">
        <%= details_li("Filename") { image.filename.to_s } %>
        <%= details_li("Image URL") { image.filename.to_s } %>
        <%= details_li("Content Type") { image.content_type } %>
        <%= details_li("Width") { "#{number_with_precision(image.width, precision: 0)}px" } %>
        <%= details_li("Height") { "#{number_with_precision(image.height, precision: 0)}px" } %>
        <%= details_li("Size") { number_to_human_size(image.byte_size) } %>
        <%= details_li("Checksum") { image.checksum } %>
      </ul>
    </div>
  </div>

<% end %>
