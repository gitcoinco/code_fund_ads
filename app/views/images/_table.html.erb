<div class="table-responsive">
  <table class="table table-borderless u-datatable u-datatable__striped mt-5">
    <thead>
      <tr>
        <th scope="col">Preview</th>
        <th scope="col">Filename</th>
        <th scope="col">Name</th>
        <th scope="col" class="text-center">Format</th>
        <th scope="col" class="text-center">Content Type</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "/images/tr", collection: @images, as: :image %>
    </tbody>
    <tfoot>
      <tr class="border-top">
        <td colspan="5" class="pt-3">
          <%== pagy_nav_bootstrap(@pagy) if @pagy.pages > 1 %>
        </td>
      </tr>
    </tfoot>
  </table>
</div>
