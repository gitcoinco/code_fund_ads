<% content_for :breadcrumbs do %>
  <%= render "/@shared/breadcrumbs/dashboard" %>
  <%= render "/@shared/breadcrumbs/images", imageable: @imageable %>
  <%= render "/@shared/breadcrumbs/add_image", class: "active" %>
<% end %>

<% content_for :actions do %>
  <%= render "/@shared/actions/add_images" %>
<% end %>

<% content_for :page_heading do %>
  <%= page_heading "Add", "Images",
    subtitle: "for #{@imageable.imageable_name}",
    icon: "fas fa-images" %>
<% end %>

<main id="content" role="main">
  <div class="u-bg-light-blue-50">
    <div class="container u-space-1">
      <%= render "/images/form_upload" %>
    </div>
  </div>
</div>
