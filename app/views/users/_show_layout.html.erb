<main id="content" role="main" class="bg-light">
  <div class="container space-1">
    <ul class="nav nav-classic">
      <li class="nav-item">
        <%= active_link_to "Details", user_path(user), active: :exact,
          data: { turbolinks_persist_scroll: true, prefetch: true }, class: "nav-link" %>
      </li>
      <li class="nav-item">
        <%= active_link_to "Properties", user_properties_path(user),
          data: { turbolinks_persist_scroll: true, prefetch: true }, class: "nav-link" %>
      </li>
      <li class="nav-item">
        <%= active_link_to "Campaigns", user_campaigns_path(user),
          data: { turbolinks_persist_scroll: true, prefetch: true }, class: "nav-link" %>
      </li>
      <li class="nav-item">
        <%= active_link_to "Notes", user_comments_path(user),
          data: { turbolinks_persist_scroll: true, prefetch: true }, class: "nav-link" %>
      </li>
      <li class="nav-item">
        <%= active_link_to "Versions", user_versions_path(user),
          data: { turbolinks_persist_scroll: true, prefetch: true }, class: "nav-link" %>
      </li>
    </ul>
    
    <div class="bg-white border border-top-0 p-4">
      <%= yield %>
    </div>
  </div>
</main>