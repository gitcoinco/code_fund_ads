<% content_for :breadcrumbs do %>
  <%= render "/@shared/breadcrumbs/dashboard" %>
  <%= render "/@shared/breadcrumbs/users" %>
  <%= render "/@shared/breadcrumbs/user", user: @user, class: "active" %>
<% end %>

<% content_for :actions do %>
  <%= render "/@shared/actions/edit_user", user: @user %>
<% end %>

<% content_for :page_heading do %>
  <%= page_heading @user.first_name, @user.last_name,
    subtitle: @user.email,
    icon: "fas fa-user-circle" %>
<% end %>

<%= render layout: "/users/show_layout", locals: { user: @user } do %>
  <div class="row">
    <div class="col-md-6 col-lg-4">
      <%= render "/users/card", user: @user %>
    </div>
    <div class="col-md-6 col-lg-8">
      <ul class="list-unstyled mb-0">
        <%= details_li("Name") { @user.name } %>
        <%= details_li("Company Name") { @user.company_name } %>
        
      </ul>
    </div>
  </div>
<% end %>

