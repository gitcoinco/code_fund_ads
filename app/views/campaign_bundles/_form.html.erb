<%= form_with model: @campaign_bundle do |f| %>
  <div class="row">
    <div class="col-8 form-group">
      <%= f.label :name %>
      <%= f.text_field :name, class: "form-control", required: true %>
    </div>
  </div>

  <div class="row">
    <div class="col-8 form-group">
      <%= f.label :url, "URL" %>
      <%= f.text_field :url, class: "form-control", required: true %>
    </div>
  </div>

  <div class="row">
    <div class="col-3 form-group">
      <%= f.label :daily_budget, "Daily Budget" %>
      <%= f.text_field :daily_budget, class: "form-control", required: true %>
      <small class="form-text text-muted">
        The average you want to spend each day
      </small>
    </div>
    <div class="col-5 pt-4 text-info">
      For the month, you won't pay more than your daily budget times the average number of days in a month.
      Some days you might spend more or less than your daily budget.
    </div>
  </div>

  <div class="row">
    <div class="col-3 form-group">
      <%= f.label :start_date, "Start Date" %>
      <%= f.text_field :start_date, required: true,
        class: "js-range-datepicker form-control bg-white rounded-right",
        data: {controller: "select-date"} %>
    </div>
    <div class="col-3 form-group">
      <%= f.label :end_date, "End Date" %>
      <%= f.text_field :end_date,
        class: "js-range-datepicker form-control bg-white rounded-right",
        data: {controller: "select-date"} %>
      <small class="form-text text-muted">
        Your ads will continue to run unless you specify an end date.
      </small>
    </div>
  </div>

  <div class="row">
    <div class="col-8">
      <%= f.label :regions, "Regions" %>
      <% Region.order(:name).each do |region| %>
        <div class="form-check">
          <%= f.check_box :region_ids, {id: dom_id(region), class: "form-check-input", multiple: true}, region.id, @campaign_bundle.region_ids.include?(region.id) %>
          <%= f.label region.name, region.name, for: dom_id(region), class: "form-check-label" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="row mt-5">
    <div class="col-12">
      <%= link_to "Add Campaign", "", class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>
