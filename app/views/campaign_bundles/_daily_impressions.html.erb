<% cache @campaign_bundle.region_ids do %>
  <% if @campaign_bundle.region_ids.present? %>
    <div class="card mt-2">
      <div class="card-header bg-muted">
        <h5><%= number_with_delimiter @campaign_bundle.average_daily_impressions_count %> daily impressions</h5>
        <div class="opacity-60">Average inventory based on your targeting but not your budget or availability</div>
      </div>
      <div class="card-body">
        <h6 class="text-muted">Top Countries</h6>
        <table class="table table-sm table-hover table-bordered">
          <thead>
            <tr class="bg-light">
              <th class="rounded-0">Country</th>
              <th class="rounded-0"><small class="d-block opacity-60">Projected</small>Impressions</th>
            </tr>
          </thead>
          <tbody>
            <% @campaign_bundle.countries.sort_by(&:average_daily_impressions_count).reverse[0,5].each do |country| %>
              <tr>
                <td>
                <%= country.emoji_flag %>
                <%= truncate country.name, length: 24 %>
                </td>
                <td class="text-right">
                  <%= number_with_delimiter country.average_daily_impressions_count %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <h6 class="text-muted">Audiences</h6>
        <table class="table table-sm table-hover table-bordered">
          <thead>
            <tr class="bg-light">
              <th class="rounded-0">Audience</th>
              <th class="rounded-0"><small class="d-block opacity-60">Projected</small>Impressions</th>
            </tr>
          </thead>
          <tbody>
            <% Audience.all.each do |audience| %>
              <tr>
                <td><%= audience.name %></td>
                <td class="text-right"><%= number_with_delimiter Country.average_daily_impressions_count(countries: @campaign_bundle.countries, audience: audience) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
<% end %>
