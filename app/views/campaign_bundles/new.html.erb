<div class="container mt-5 position-relative" data-controller="campaign-bundles">
  <div class="row">
    <div class="col-8">
      <h1>New Ad Bundle</h1>
      <%= render "/campaign_bundles/form" %>
    </div>
    <div class="col-4 mt-5 pt-4">
      <% if @campaign_bundle.region_ids.present? %>
        <div class="card mt-2">
          <div class="card-header bg-muted">
            <%= number_with_delimiter @campaign_bundle.average_daily_impressions_count %> <u>estimated</u> daily impressions
            <small class="text-danger d-block">Based on your targeting and settings but not your budget</small>
          </div>
          <div class="card-body">
            <table class="table table-sm table-hover">
              <thead>
                <tr class="bg-light">
                  <th>Audience</th>
                  <th>Impressions</th>
                </tr>
              </thead>
              <tbody>
                <% Audience.all.each do |audience| %>
                  <tr>
                    <td><%= audience.name %></td>
                    <td class="text-right"><%= number_with_delimiter Country.average_daily_impressions_count(countries: @campaign_bundle.countries, audience: audience) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="card mt-2">
          <div class="card-header bg-muted">
            Top Countries <small><u>estimated</u> daily impressions</small>
            <small class="text-danger d-block">Based on your targeting and settings but not your budget</small>
          </div>
          <div class="card-body">
            <table class="table table-sm table-hover">
              <thead>
                <tr class="bg-light">
                  <th>Country</th>
                  <th>Impressions</th>
                </tr>
              </thead>
              <tbody>
                <% @campaign_bundle.countries.sort_by(&:average_daily_impressions_count).reverse[0,6].each do |country| %>
                  <tr>
                    <td>
                    <%= country.emoji_flag %>
                    <%= truncate country.name, length: 24 %>
                    </td>
                    <td class="text-right">
                      <%= number_with_delimiter country.average_daily_impressions_count %>
                    </td>
                  </tr>
                  <tr>
                    <td colspan="2" class="pl-1">
                      <details>
                        <summary class="text-muted">Audience Breakdown</summary>
                        <table class="table table-sm table-hover">
                          <thead>
                            <tr class="bg-light">
                              <th>Audience</th>
                              <th>Impressions</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% Audience.all.each do |audience| %>
                              <tr>
                                <td><%= audience.name %></td>
                                <td class="text-right"><%= number_with_delimiter country.average_daily_impressions_count(audience: audience) %></td>
                              </tr>
                            <% end %>
                          </tbody>
                        </table>
                      </details>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>

      <% if @campaign_bundle.competing_campaigns.exists? %>
        <div class="card mt-2">
          <div class="card-header bg-muted">
            Competition
            <small class="opacity-60 d-block">Campaigns targeting the same dates and locations</small>
          </div>
          <div class="card-body mb-2">
            <h5><%= @campaign_bundle.competing_campaigns.size %> <%= "campaign".pluralize @campaign_bundle.competing_campaigns.size %></h5>
            <h6>Reserved Daily Budget by Region</h6>
            <% @campaign_bundle.competing_daily_budget_by_region.each do |region, daily_budget| %>
              <div><%= region.name %>: <%= daily_budget.format %></div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
