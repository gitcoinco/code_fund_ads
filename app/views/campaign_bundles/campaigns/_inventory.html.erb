<% cache campaign.inventory_summary, expires_in: 1.hour.from_now do %>
  <div class="card mt-2">
    <div class="card-header bg-muted">
      <div class="progress bg-light" style="height:8px" title="<%= number_to_percentage campaign.inventory_summary.available_daily_inventory_percentage * 100, precision: 1 %> available">
        <div class="progress-bar" role="progressbar" style="width:<%= campaign.inventory_summary.available_daily_inventory_percentage * 100 %>%" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
      </div>
      <h5 class="mt-2 <%= classes "text-danger": campaign.inventory_summary.available_daily_inventory_value <= 0 %>">
        <%= tag.span number_with_delimiter campaign.inventory_summary.avaliable_daily_impressions_count, class: "text-monospace" %> impressions/day available*
        <small class="d-block">Available daily inventory valued at <%= tag.span campaign.inventory_summary.available_daily_inventory_value.format, class: "font-weight-bold text-monospace" %></small>
      </h5>
      <div class="text-muted">
        Approximation of available daily impressions and their value.
      </div>
      *Check future dates to ensure we don't oversell.
      <small class="d-block mt-2">Average daily inventory valued at <%= tag.span campaign.inventory_summary.average_daily_inventory_value.format, class: "text-monospace" %></small>
    </div>
    <div class="card-body" style="max-height:400px; overflow-y:scroll;">

      <h6 class="text-muted">eCPM by Region & Audience</h6>
      <table class="table table-sm table-hover table-bordered">
        <thead>
          <tr class="bg-light">
            <th class="rounded-0">Region</th>
            <th class="rounded-0">Audience</th>
            <th class="rounded-0"><small class="d-block opacity-60">Base</small>eCPM</th>
            <th class="rounded-0"><small class="d-block opacity-60">Adjusted</small>eCPM</th>
          </tr>
        </thead>
        <tbody>
          <% campaign.inventory_summary.inventory_details.map do |inventory_detail| %>
            <tr title="<%= "#{inventory_detail.region.name} + #{inventory_detail.audience.name}" %>">
              <td><small class="text-nowrap"><%= truncate inventory_detail.region.name, length: 18 %></small></td>
              <td><small class="text-nowrap"><%= truncate inventory_detail.audience.name, length: 18 %></small></td>
              <td class="text-right text-monospace"><%= inventory_detail.base_ecpm.format %></td>
              <td class="text-right text-monospace"><%= inventory_detail.adjusted_ecpm.format %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="bg-light">
            <td class="text-right font-weight-bold" colspan="2">Average</td>
            <td class="text-right font-weight-bold text-monospace"><%= campaign.inventory_summary.average_base_ecpm.format %></td>
            <td class="text-right font-weight-bold text-monospace"><%= campaign.inventory_summary.average_adjusted_ecpm.format %></td>
          </tr>
        </tfoot>
      </table>

      <h6 class="text-muted">
        Sold Daily Inventory
        <small class="d-block">
          based on campaigns targeting the same inventory operating on
          <%= tag.span @campaign_bundle.start_date.to_s("mm/dd/yyyy"), class: "text-monospace" %>
        </small>
      </h6>
      <table class="table table-sm table-hover table-bordered">
        <thead>
          <tr class="bg-light">
            <th class="rounded-0">#</th>
            <th class="rounded-0">Region</th>
            <th class="rounded-0">Audience</th>
            <th class="rounded-0"><small class="d-block opacity-60">Projected Daily</small>Impressions</th>
            <th class="rounded-0"><small class="d-block opacity-60">Projected Daily</small>Value</th>
          </tr>
        </thead>
        <tbody>
          <% campaign.inventory_summary.inventory_details.sort_by(&:impressions_count).reverse.each_with_index do |inventory_detail, index| %>
            <tr title="<%= "#{inventory_detail.region.name} + #{inventory_detail.audience.name}" %>">
              <td><%= index + 1 %></td>
              <td><small class="text-nowrap"><%= truncate inventory_detail.region.name, length: 18 %></small></td>
              <td><small class="text-nowrap"><%= truncate inventory_detail.audience.name, length: 18 %></small></td>
              <td class="text-right text-monospace"><%= number_with_delimiter inventory_detail.impressions_count %></td>
              <td class="text-right text-monospace"><%= inventory_detail.impressions_value.format %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="bg-light">
            <td class="text-right font-weight-bold" colspan="3">Total Sold <small>daily</small></td>
            <td class="text-right font-weight-bold text-monospace"><%= number_with_delimiter campaign.inventory_summary.average_daily_impressions_count %></td>
            <td class="text-right font-weight-bold text-monospace"><%= campaign.inventory_summary.average_daily_inventory_value.format %></td>
          </tr>
          <tr class="bg-light">
            <td class="text-right font-weight-bold" colspan="3">Total Unsold <small>daily</small></td>
            <td class="text-right font-weight-bold text-monospace"><%= tag.span number_with_delimiter campaign.inventory_summary.avaliable_daily_impressions_count, class: "text-monospace" %></td>
            <td class="text-right font-weight-bold text-monospace"><%= tag.span campaign.inventory_summary.available_daily_inventory_value.format, class: "font-weight-bold text-monospace" %></td>
          </tr>
        </tfoot>
      </table>

      <% if campaign.inventory_summary.competitors.present? %>
        <h6 class="text-muted">
          Active Campaigns
          <small class="d-block">targeting the same inventory operating on <%= tag.span @campaign_bundle.start_date.to_s("mm/dd/yyyy"), class: "text-monospace" %></small>
        </h6>
        <table class="table table-sm table-hover table-bordered">
          <thead>
            <tr class="bg-light">
              <th class="rounded-0">Name</th>
              <th class="rounded-0">Daily Budget</th>
              <th class="rounded-0">Start</th>
              <th class="rounded-0">End</th>
            </tr>
          </thead>
          <tbody>
            <% campaign.inventory_summary.competitors.each do |c| %>
              <tr>
                <td><%= truncate c.name, length: 12 %></td>
                <td class="text-right text-monospace"><%= c.daily_budget.format %></td>
                <td class="text-right text-monospace"><%= c.start_date.to_s("mm/dd/yyyy") %></td>
                <td class="text-right text-monospace"><%= c.end_date&.to_s("mm/dd/yyyy") %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="bg-light">
              <td class="text-right font-weight-bold">Total</td>
              <td class="text-right font-weight-bold text-monospace"><%= campaign.inventory_summary.competitors_total_daily_budget.format %></td>
              <td></td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      <% end %>

      <% if campaign.inventory_summary.future_competitors.present? %>
        <h6 class="text-muted">
          Future Campaigns
          <small class="d-block">targeting the same inventory starting after <%= tag.span @campaign_bundle.start_date.to_s("mm/dd/yyyy"), class: "text-monospace" %></small>
        </h6>
        <table class="table table-sm table-hover table-bordered">
          <thead>
            <tr class="bg-light">
              <th class="rounded-0">Name</th>
              <th class="rounded-0">Daily Budget</th>
              <th class="rounded-0">Start</th>
              <th class="rounded-0">End</th>
            </tr>
          </thead>
          <tbody>
            <% campaign.inventory_summary.future_competitors.each do |c| %>
              <tr>
                <td><%= truncate c.name, length: 12 %></td>
                <td class="text-right text-monospace"><%= c.daily_budget.format %></td>
                <td class="text-right text-monospace"><%= c.start_date.to_s("mm/dd/yyyy") %></td>
                <td class="text-right text-monospace"><%= c.end_date&.to_s("mm/dd/yyyy") %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="bg-light">
              <td class="text-right font-weight-bold">Total</td>
              <td class="text-right font-weight-bold text-monospace"><%= campaign.inventory_summary.future_competitors_total_daily_budget.format %></td>
              <td></td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      <% end %>

    </div>
  </div>
<% end %>
