<%= table_wrapper do %>
  <%= paginated_table do %>
    <%= table_head do %>
        <%= table_row header: true do %>
        <%= table_column(add_style: "min-width: 260px") { "Name" } %>
      <% end %>
    <% end %>
    <%= table_body do %>
      <% if campaign_bundles.exists? %>
        <% campaign_bundles.each do |campaign_bundle| %>
          <%= table_row do %>
            <%= table_data add_class: "text-truncate" do %>
              <%= link_to campaign_bundle.name, campaign_bundle %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <%= render "/shared/no_data_alert" %>
      <% end %>
    <% end %>
  <% end %>
  <%= pagination_wrapper do %>
    <span><%== pagy_bootstrap_nav(pagy) if pagy.pages > 1 %></span>
    <%= pagy_entries(pagy) %>
  <% end %>
<% end %>
