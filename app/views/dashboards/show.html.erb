<% content_for :breadcrumbs do %>
  <%= render "/@shared/breadcrumbs/dashboard", class: "active" %>
<% end %>

<% content_for :actions do %>
  <%= render "/@shared/actions/placeholder" %>
<% end %>

<% content_for :page_heading do %>
  <%= page_heading @context.humanize, "Dashboard",
    subtitle: "Overall view of your account",
    icon: "fas fa-tachometer" %>
<% end %>

<main id="content" role="main">
  <div class="bg-light">
    <%= render "/dashboards/advertiser" if @context == "advertiser" %>
    <%= render "/dashboards/publisher"  if @context == "publisher" %>
  </div>
</main>