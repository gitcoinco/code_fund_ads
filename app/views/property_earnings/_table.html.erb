<div class="table-responsive">
  <table class="js-datatable table table-striped table-compact table-borderless u-datatable u-datatable__striped u-datatable__trigger">
    <thead>
      <tr class="border-bottom">
        <th style="width: 20%;">Date</th>
        <th class="text-center" style="width: 20%;">Impressions</th>
        <th class="text-center" style="width: 20%;">Clicks</th>
        <th class="text-center" style="width: 20%;"><span class="d-block small text-muted">average</span>CTR</th>
        <th class="text-center" style="width: 20%;">Earnings</th>
      </tr>
    </thead>
    <tbody>
      <% @property.probable_dates_with_impressions.each do |date| %>
        <tr>
          <td><%= date.to_s("abdy") %></td>
          <td class="text-right"><%= number_with_delimiter @property.daily_impressions_count(date) %></td>
          <td class="text-right"><%= number_with_delimiter @property.daily_clicks_count(date) %></td>
          <td class="text-right"><%= number_to_percentage @property.daily_click_rate(date), precision: 2 %></td>
          <td class="text-right"><%= @property.estimated_property_revenue(date).format %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
