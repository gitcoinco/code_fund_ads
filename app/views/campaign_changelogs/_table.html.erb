<div class="table-responsive">
  <table class="js-datatable table table-striped table-compact table-borderless u-datatable u-datatable__striped u-datatable__trigger">
    <thead>
      <tr class="border-bottom">
        <th>Index</th>
        <th>Date</th>
        <th>Author</th>
        <th>Event</th>
        <th>&nbsp;</th>
      </tr>
    </thead>
    <tbody>
      <% versions.reverse.each do |version| %>
      <tr>
        <td><%= version.index %></td>
        <td><%= version.created_at %></td>
        <td><%= link_to find_version_author(version), user_path(find_version_author(version)) %></td>
        <td><%= version.event.humanize %></td>
        <td class="text-right">
          <a data-controller="remote-modal"
						data-action="click->remote-modal#displayModal"
            data-url="<%= diff_campaign_campaign_changelog_path(@campaign, version) %>"
						href="#">
            <i class="fas fa-exchange"></i> Diff
          </a>
        </td>
      </tr>
      <% end %>
    </tbody>
  </table>
</div>
