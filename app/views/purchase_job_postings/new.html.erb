<main id="content" role="main" class="bg-light" data-controller="stripe-checkout">
  <div class="container space-top-3 space-bottom-2">
    <div class="w-lg-80 mx-lg-auto">
      <div class="card shadow-sm p-7 job-listing">
        <nav class="nav nav-icon nav-justified text-center">
          <%= link_to edit_job_posting_path(@job_posting), class: "nav-item" do %>
            <span class="nav-icon-action transition-3d-hover">
              <span class="fas fa-check-square nav-icon-action-inner"></span>
            </span>
            Modify Ad
          <% end %>
          <%= link_to job_posting_path(@job_posting), class: "nav-item" do %>
            <span class="nav-icon-action transition-3d-hover">
              <span class="fas fa-thumbs-up nav-icon-action-inner"></span>
            </span>
            Preview
          <% end %>
          <%= link_to "javascript:;", class: "nav-item active text-dark" do %>
            <span class="nav-icon-action bg-success">
              <span class="fas fa-file-invoice-dollar nav-icon-action-inner"></span>
            </span>
            Purchase
          <% end %>
        </nav>

        <div class="space-1">
          <%= simple_form_for @user, url: purchase_job_posting_path(@job_posting),
                data: { target: "stripe-checkout.form" } do |form| %>
            <%= render partial: "/purchase_job_postings/user_form", locals: { form: form } unless current_user %>
            <input type="hidden" name="token" data-target="stripe-checkout.tokenInput" />

            <div class="form-group required form-group-valid">
              <label class="form-control-label required">Credit Card <abbr title="required">*</abbr></label>
              <div data-target="stripe-checkout.card" class="border rounded p-3">
                <!-- A Stripe Element will be inserted here. -->
              </div>
            </div>

            <!-- Used to display stripe form errors. -->
            <div class="error" role="alert">
              <span class="message"></span>
            </div>
      
            <div class="text-center">
              <button type="submit" class="btn btn-primary d-block mx-auto">Pay $299</button>
              <%= link_to "Make Changes", edit_job_posting_path(@job_posting),
                  class: "btn btn-sm text-muted btn-link" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</main>