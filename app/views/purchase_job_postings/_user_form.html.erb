<%= render "/@shared/forms/error_messages", object: @user %>

<h2 class="h5 mt-3">Register with CodeFund</h2>

<p>
  It looks like this might be your first job posting with CodeFund. In order to post a job,
  we need to create a user account. With this account, you will have access to:
</p>

<ul class="text-muted pb-3">
  <li>Anaytics (impressions, clicks)</li>
  <li>Renewals and cancellations</li>
  <li>CodeFund Ads placement (coming soon)</li>
</ul>

<div class="row">
  <%= tag.div form.input(:first_name, required: true, placeholder: "First Name",
    input_html: { data: { target: "stripe-checkout.firstName" }}), class: "col-md-6" %>
  <%= tag.div form.input(:last_name, required: true, placeholder: "Last Name",
    input_html: { data: { target: "stripe-checkout.lastName" }}), class: "col-md-6" %>
  <%= tag.div form.input(:company_name, required: true, placeholder: "Company Name",
    input_html: { data: { target: "stripe-checkout.companyName" }}), class: "col-12" %>
  <%= tag.div form.input(:email, required: true, as: :email, placeholder: "Email Address",
    input_html: { data: { target: "stripe-checkout.email" }}), class: "col-12" %>
</div>