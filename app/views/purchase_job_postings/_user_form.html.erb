<%= simple_form_for @user, wrapper: :front_form do |f| %>
  <input type="hidden" name="redir" value="<%= new_purchase_job_posting_path(@job_posting) %>">

  <%= render "/@shared/forms/error_messages", object: @user %>

  <h2 class="h5 mt-3">Register with CodeFund</h2>
  <p class="text-black-50">
    It looks like this might be your first job posting with CodeFund. In order to post a job,
    we need to create a user account. With this account, you will have access to:
  </p>
  <ul class="text-black-50 pb-3">
    <li>Anaytics (impressions, clicks)</li>
    <li>Renewals and cancellations</li>
    <li>CodeFund Ads placement (coming soon)</li>
  </ul>
  
  <div class="row">
    <%= tag.div f.input(:first_name, required: true), class: "col-md-6 mb-3" %>
    <%= tag.div f.input(:last_name, required: true), class: "col-md-6 mb-3" %>
    <%= tag.div f.input(:company_name, required: true), class: "col-12 mb-3" %>
    <%= tag.div f.input(:email, required: true, as: :email), class: "col-md-6 mb-3" %>
    <%= tag.div f.input(:password, required: true), class: "col-md-6 mb-3" %>
  </div>

  <div class="text-center mt-5">
    <%= f.submit "Create Account", class: "btn btn-primary" %>
  </div>
<% end %>