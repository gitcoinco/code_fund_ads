<div id="cf">
  <span>
    <span class="cf-wrapper">
      <%= link_to advertisement_clicks_path(@virtual_impression_id), class: "cf-img-wrapper", target:"_blank", rel:"noopener" do %>
        <%= image_tag url_for(@campaign.creative.large_image), border: 0, height: 100, width: 130, class: "cf-img" %>
      <% end %>
      <%= link_to @campaign.url, class: "cf-text", target:"_blank", rel:"noopener" do %>
        <strong><%= @campaign.creative.headline %></strong>
        <span><%= @campaign.creative.body %></span>
      <% end %>
      <%= render "/ad_templates/powered_by" %>
    </span>
  </span>
</div>
