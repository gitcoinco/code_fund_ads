<div id="cf" data-template="top-bar" data-theme="{{theme}}">
  <a href="{{urls.campaign}}" class="cf-sponsored-by" target="_blank" rel="noopener sponsored">
    <img src="{{creative.imageUrls.wide}}" alt="{{creative.name}}" border="0" height="50" class="cf-img">
    <span class="cf-text">
      <strong class="cf-headline">{{creative.headline}}</strong>
      <span class="cf-body">{{creative.body}}</span>
    <span>
    <span class="cf-cta">{{creative.cta}}</span>
  </a>
  <span class="cf-footer">
    <a href="{{urls.poweredBy}}" class="cf-powered-by" rel="noopener sponsored" target="_blank">Ethical ad by CodeFund</a>
    <span data-behavior="close">Close</span>
    <img data-src="{{urls.impression}}" class="cf-impression" alt="">
  </span>
</div>
