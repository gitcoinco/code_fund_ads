<%= table_row add_class: ("border-bottom" if @date.saturday?) do %>
  <%= table_data_value @date.to_s("abdy") %>
  <%= table_data_value number_with_delimiter(@property.impressions_count(@date), premium: true) %>
  <%= table_data_value number_with_delimiter(@property.clicks_count(@date), premium: true) %>
  <%= table_data_value number_to_percentage(@property.click_rate(@date), premium: true, precision: 2) %>
  <%= table_data_value number_with_delimiter(@property.impressions_count(@date), fallback: true) %>
  <%= table_data_value number_with_delimiter(@property.clicks_count(@date), fallback: true) %>
  <%= table_data_value number_to_percentage(@property.click_rate(@date), fallback: true, precision: 2) %>
  <%= table_data_value @property.property_revenue(@date).format %>
<% end %>
