<% content_for :page_heading do %>
  <%= page_heading "Viewing", "Campaign",
    subtitle: @campaign.name,
    icon: "fas fa-ad" %>
<% end %>

<% content_for :actions do %>
  <%= actions_list do %>
    <%= actions_date_range_picker %>
    <%= actions_list_item title: "Edit Campaign" do %>
      <%= render "/shared/actions/edit_campaign", campaign: @campaign %>
    <% end %>
    <%= actions_list_item title: "Clone Campaign" do %>
      <%= render "/shared/actions/generic", link: new_campaign_path(clone: @campaign.id), icon: "fa fa-copy" %>
    <% end %>
  <% end %>
<% end %>


<%= render layout: "/campaigns/layout", locals: { campaign: @campaign } do %>
  <div class="row">
    <div class="col-md-6 col-lg-4">
      <% if @campaign.standard? %>
        <%= render "campaigns/standard_card", campaign: @campaign %>
      <% end %>
      <%= render "campaigns/creative_previews", campaign: @campaign %>
    </div>
    <div class="col-md-6 col-lg-8">
      <%= render "campaigns/details_card" %>
    </div>
  </div>
<% end %>
