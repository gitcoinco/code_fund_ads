<div class="table-responsive">
  <%= table add_class: "dt-responsive nowrap w-100 dtr-inline", compact: true do %>
    <%= table_head do %>
      <tr>
        <th>Date</th>
        <th class="text-right">Impressions</th>
        <th class="text-right">Clicks</th>
        <th class="text-right">CTR</th>
        <th class="text-right">Earnings</th>
      </tr>
    <% end %>
    <%= table_body do %>
      <% report.each do |item| %>
        <tr>
          <td class="align-middle">
            <%= item.displayed_at_date %>
            <small class="d-block text-muted">Fallback</small>
          </td>
          <td class="text-right">
            <%= number_with_delimiter item.impressions_count %>
            <small class="d-block text-muted"><%= number_with_delimiter item.fallbacks_count %></small>
          </td>
          <td class="text-right">
            <%= number_with_delimiter item.clicks_count %>
            <small class="d-block text-muted">-</small>
          </td>
          <td class="text-right">
            <%= number_to_percentage item.click_rate, precision: 3 %>
            <small class="d-block text-muted">-</small>
          </td>
          <td class="text-right">
            <%= Money.new(item.property_revenue_cents / 100).format %>
            <small class="d-block text-muted">$0.00</small>
          </td>
        </tr>
      <% end %>
    <% end %>
  <% end %>
</div>
