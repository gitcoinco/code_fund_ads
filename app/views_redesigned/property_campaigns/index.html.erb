<%= render layout: "/shared/layout", locals: {
  subject: @property,
  sidebar: true,
  datepicker: true,
  buttons: [
    layout_button(link: new_property_path, icon: "fas fa-plus", title: "New property"),
    layout_button(link: new_property_path(clone: @property_id), icon: "fad fa-copy", title: "Clone property")
  ]
} do %>
  <div class="card">
    <%= render "/property_campaigns/table", report: @report %>
  </div>
<% end %>
