<%= table_wrapper do %>
  <%= paginated_table do %>
    <%= table_head do %>
      <%= table_row header: true do %>
        <%= table_column { "Name" } %>
        <%= table_column add_class: "text-right" do %>Impressions<% end %>
        <%= table_column add_class: "text-right" do %>Clicks<% end %>
        <%= table_column add_class: "text-right" do %>CTR<% end %>
        <%= table_column add_class: "text-right" do %>Earnings<% end %>
      <% end %>
    <% end %>
    <%= table_body do %>
      <% @report.each do |item| %>
        <tr>
          <td class="align-middle">
            <%= item.scoped_by.name %>
             <sup><%= link_to tag.i("", class: "fas fa-external-link"), item.scoped_by.url, target: "_blank", class: "color: blue" %></sup>
          </td>
          <td class="text-right">
            <%= number_with_delimiter item.impressions_count %>
          </td>
          <td class="text-right">
            <%= number_with_delimiter item.clicks_count %>
          </td>
          <td class="text-right">
            <%= number_to_percentage item.click_rate, precision: 3 %>
          </td>
          <td class="text-right">
            <%= Money.new(item.property_revenue_cents / 100).format %>
          </td>
        </tr>
      <% end %>
    <% end %>
  <% end %>
<% end %>
