<%= render layout: "/shared/layout", locals: {
  subject: @creative,
  tabs: false,
  buttons: [
    layout_button(link: new_creative_path(clone: @creative.id), icon: "fad fa-copy", title: "Clone creative"),
    layout_button(link: creative_path(@creative), icon: "fas fa-trash", method: :delete, title: "Delete creative", add_class: "btn-danger")
  ]
} do %>
  <%= card do %>
    <%= card_body do %>
      <ul class="list-group list-group-bordered list-group-flush">
        <% if @creative.standard? %>
          <% ENUMS::AD_TEMPLATES.values.each do |template| %>
            <% ["light", "dark"].each do |theme| %>
              <%= render partial: "/creatives/preview_card", locals: {creative: @creative, template: template, theme: theme} %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
<% end %>
